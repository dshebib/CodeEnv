    // Defaults not repeated here: copy ctrl+shift+c, paste ctrl+shift+v, find ctrl+shift+f,
    // duplicateTab ctrl+shift+d, newWindow ctrl+shift+n.
    "actions": [
        { "command": { "action": "splitPane", "split": "left", "splitMode": "duplicate" }, "id": "User.DuplicatePaneLeft" }
    ],
    "keybindings": [
        { "keys": "alt+shift+d",  "id": "Terminal.DuplicatePaneAuto" },   // no default key anymore
        { "keys": "ctrl+shift+[", "id": "User.DuplicatePaneLeft" },
        { "keys": "ctrl+shift+]", "id": "Terminal.DuplicatePaneRight" },
        { "keys": "ctrl+shift+-", "id": "Terminal.DuplicatePaneDown" },

        { "keys": "ctrl+shift+h", "id": "Terminal.MoveFocusLeft" },
        { "keys": "ctrl+shift+j", "id": "Terminal.MoveFocusDown" },
        { "keys": "ctrl+shift+k", "id": "Terminal.MoveFocusUp" },         // overrides default ClearBuffer
        { "keys": "ctrl+shift+l", "id": "Terminal.MoveFocusRight" },

        { "keys": "ctrl+alt+h",   "id": "Terminal.ResizePaneLeft" },
        { "keys": "ctrl+alt+j",   "id": "Terminal.ResizePaneDown" },
        { "keys": "ctrl+alt+k",   "id": "Terminal.ResizePaneUp" },
        { "keys": "ctrl+alt+l",   "id": "Terminal.ResizePaneRight" },

        { "keys": "ctrl+shift+z", "id": "Terminal.TogglePaneZoom" },
        { "keys": "ctrl+shift+o", "id": "Terminal.ExportBuffer" }          // opens a save-file picker
    ]
