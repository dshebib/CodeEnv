[user]
	email = danielshebib@gmail.com
	name = Daniel Shebib
[init]
	defaultBranch = main
[core]
	editor = vim
[alias]
	slog = log --graph --all --topo-order --pretty='format:%h %ai %s%d (%an)'
[branch]
	sort = -authordate
[push]
	autoSetupRemote = true
[rebase]
	rebaseMerges = true
	autoSquash = true
[diff]
	tool = vimdiff
	colorMoved = dimmed-zebra
	colorMovedWS = allow-indentation-change
[difftool]
	prompt = false
[merge]
	tool = vimdiff
